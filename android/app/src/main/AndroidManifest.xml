<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for Supabase (auth + record sync) and the verify-proof
         Edge Function. Declared in the MAIN manifest so RELEASE builds get it:
         Flutter only auto-adds INTERNET to the debug/profile manifests, so a
         release build without this line would ship with no network. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- photo_manager gallery access on Android 13+ (API 33+). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <!-- Cairn Camera Capture.dc.html's custom in-app camera (camera package). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Habit reminders / streak warnings (flutter_local_notifications). Runtime
         prompt on Android 13+ (API 33+); a no-op permission on older versions.
         Already implied transitively by the plugin's own manifest, but declared
         here too so it's visible as an intentional part of THIS app rather than
         an implicit merge. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Exact alarms for reliable habit reminder and streak warning delivery. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- So a scheduled reminder/streak-warning survives a device reboot instead
         of silently vanishing until the app is next opened (see the boot
         receiver declared below, between <application> tags). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- required="false": a device/emulator with no camera hardware must
         still be able to install the app, since the gallery path is always
         available as a fallback for every task (see CameraCaptureScreen's
         graceful degradation when CameraSession.initialize() fails). -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="Cairn"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- android:screenOrientation="portrait" is a user decision (2026-08-06).
             Every screen in design/ is a portrait phone mockup, so landscape was
             never a designed state: the camera preview's broken aspect ratio was
             the visible casualty, but no other screen had been checked in
             landscape either. Locking removes the whole class of bug rather than
             that one instance.

             Declared here rather than via SystemChrome.setPreferredOrientations
             because the manifest applies before Flutter boots, so the splash
             window is portrait too; setting it only in Dart would leave the
             launch window free to rotate.

             Known trade-off: Play's large-screen quality guidelines flag
             portrait-only apps on tablets/Chromebooks. Cairn is a phone-first
             Android app, so that is accepted; revisit if large screens are ever
             targeted. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications: the receiver that actually fires a
             scheduled notification (required for zonedSchedule to work at all),
             plus the boot receiver that reschedules everything after a reboot/
             app update (RECEIVE_BOOT_COMPLETED above is what lets Android wake
             it). Both are exported="false": only the OS/this app can invoke them. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Home-Screen App Widgets (Cairn Glance 2x2 & Cairn Next Habit 4x2) -->
        <receiver
            android:name=".CairnGlanceWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cairn_glance_widget_info" />
        </receiver>

        <receiver
            android:name=".CairnNextHabitWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cairn_next_habit_widget_info" />
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
