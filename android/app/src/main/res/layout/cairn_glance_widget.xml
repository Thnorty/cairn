<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Big Altitude Hero + Streak Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_glance_altitude"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="0 m"
            android:textColor="#33302B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_glance_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_sage"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="🔥 0d"
            android:textColor="#445929"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Rank Subtitle -->
    <TextView
        android:id="@+id/widget_glance_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Pebble"
        android:textColor="#6E6556"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Middle: Next Habit Highlight or Status -->
    <TextView
        android:id="@+id/widget_glance_today_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXT HABIT"
        android:textColor="#887E6E"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_glance_next_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Read 20 pages"
        android:textColor="#33302B"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_glance_today_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 of 0 completed"
        android:textColor="#6E6556"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom: Weekly total footer -->
    <TextView
        android:id="@+id/widget_glance_week_stones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 stones this week"
        android:textColor="#887E6E"
        android:textSize="11sp" />
</LinearLayout>
